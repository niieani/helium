+// A background WebContents starts with a newer last-active timestamp than
+// the foreground tab. The first MRU step must still leave the foreground tab.
+TEST_F(BrowserCommandsTest, MruTabCyclingAfterBackgroundTabCreated) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(prefs::kTabCyclingMRU, true);
+  auto* model = browser()->tab_strip_model();
+  model->AppendWebContents(
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr),
+      true);
+  model->AppendWebContents(
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr),
+      false);
+  const auto now = base::TimeTicks::Now();
+  content::WebContentsTester::For(model->GetWebContentsAt(0))
+      ->SetLastActiveTimeTicks(now - base::Seconds(1));
+  content::WebContentsTester::For(model->GetWebContentsAt(1))
+      ->SetLastActiveTimeTicks(now);
+
+  auto* updater = chrome::BrowserCommandController::From(browser());
+  for (int command : {IDC_SELECT_NEXT_TAB, IDC_SELECT_PREVIOUS_TAB}) {
+    SCOPED_TRACE(command);
+    model->ActivateTabAt(0);
+    model->StopMRUCycling();
+    ASSERT_EQ(0, model->active_index());
+    updater->ExecuteCommand(command);
+    EXPECT_EQ(1, model->active_index());
+    model->StopMRUCycling();
+  }
+}
+
+TEST_F(BrowserCommandsTest, MruTabCyclingPreservesOtherTabsOrder) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(prefs::kTabCyclingMRU, true);
+  auto* model = browser()->tab_strip_model();
+  for (int i = 0; i < 3; ++i) {
+    model->AppendWebContents(
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr),
+        i == 1);
+  }
+  model->ActivateTabAt(1);
+  const auto now = base::TimeTicks::Now();
+  for (int i = 0; i < 3; ++i) {
+    content::WebContentsTester::For(model->GetWebContentsAt(i))
+        ->SetLastActiveTimeTicks(now - base::Seconds(2 - i));
+  }
+
+  auto* updater = chrome::BrowserCommandController::From(browser());
+  for (int expected : {2, 0, 1}) {
+    updater->ExecuteCommand(IDC_SELECT_NEXT_TAB);
+    EXPECT_EQ(expected, model->active_index());
+  }
+  for (int expected : {0, 2, 1}) {
+    updater->ExecuteCommand(IDC_SELECT_PREVIOUS_TAB);
+    EXPECT_EQ(expected, model->active_index());
+  }
+  model->StopMRUCycling();
+}
